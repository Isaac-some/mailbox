POSTGRES_PASSWORD=replace-with-a-long-random-password
MAILARCHIVE_SYNC_INTERVAL_SECONDS=21600
MAILARCHIVE_SYNC_LOOKBACK_DAYS=30
MAILARCHIVE_SYNC_INBOX_ONLY=true
MAILARCHIVE_SYNC_MAX_CONCURRENT=4
MAILARCHIVE_SYNC_STARTUP_STAGGER_SECONDS=21600
# Platform credential sync (keep real values out of source control)
PlatformAuthentication__Username=
PlatformAuthentication__Password=
# Or inject the external credential API directly for a one-process CLI run.
UpstreamMailboxSync__Enabled=true
UpstreamMailboxSync__Endpoint=https://example.com/api/external/account-credentials
UpstreamMailboxSync__BearerToken=
