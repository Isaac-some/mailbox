<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MailAssistant.Updater</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../DesktopUpdate/UpdateProtocol.cs" Link="UpdateProtocol.cs" />
    <EmbeddedResource Include="../DesktopUpdate/update-public-key.pem" LogicalName="UpdatePublicKey" />
  </ItemGroup>
</Project>
