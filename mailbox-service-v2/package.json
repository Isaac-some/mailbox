{
  "name": "mailbox-service-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/src/db/schema.sql && rm -rf dist/src/public && cp -R src/public dist/src/public",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts web",
    "dev:worker": "node --env-file-if-exists=.env --import tsx src/main.ts worker",
    "migrate": "node --env-file-if-exists=.env --import tsx src/main.ts migrate",
    "seed:admin": "node --env-file-if-exists=.env --import tsx src/main.ts seed-admin",
    "start": "node dist/src/main.js web",
    "start:worker": "node dist/src/main.js worker",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.6.0",
    "fastify": "5.12.3",
    "imapflow": "1.7.8",
    "mailparser": "^3.7.4",
    "nodemailer": "10.0.2",
    "pg": "^8.16.3",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/sanitize-html": "^2.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
