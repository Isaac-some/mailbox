NODE_ENV=production
HOST=0.0.0.0
PORT=4300
DATABASE_URL=postgres://mailbox:replace-me@postgres:5432/mailbox
CREDENTIAL_KEY_FILE=/app/secrets/credential.key
SESSION_KEY_FILE=/app/secrets/session.key
PUBLIC_ORIGIN=https://mail.example.com
TRUST_PROXY=true
GLOBAL_MAIL_CONCURRENCY=2
PROVIDER_CONNECT_INTERVAL_MS=3000
PROVIDER_PAUSE_THRESHOLD=3
MAIL_TASK_TIMEOUT_MS=180000
SYNC_LOOKBACK_DAYS=30
MAX_MESSAGES_PER_ACCOUNT=30
POSTGRES_PASSWORD=replace-me
PUBLIC_HOSTNAME=mail.example.com
