NODE_ENV=development
HOST=127.0.0.1
PORT=4300
DATABASE_URL=pglite://.data/local-postgres
CREDENTIAL_KEY_FILE=./secrets/credential.key
SESSION_KEY_FILE=./secrets/session.key
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-before-use
PUBLIC_ORIGIN=http://127.0.0.1:4300
TRUST_PROXY=false
GLOBAL_MAIL_CONCURRENCY=2
PROVIDER_CONNECT_INTERVAL_MS=3000
PROVIDER_PAUSE_THRESHOLD=3
MAIL_TASK_TIMEOUT_MS=180000
SYNC_LOOKBACK_DAYS=30
MAX_MESSAGES_PER_ACCOUNT=30

