{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.runtime/mailarchiver.local.db"
  },
  "Authentication": {
    "Enabled": false,
    "LocalBypassUsername": "mailbox-system"
  },
  "LocalAccess": {
    "Enabled": false,
    "Accounts": []
  },
  "LocalApp": {
    "Enabled": true
  },
  "UpstreamMailboxSync": {
    "Enabled": true,
    "Endpoint": "https://openrouter.tuchong.com/api/external/account-credentials",
    "BearerToken": "",
    "RequireBearerToken": true,
    "TimeoutSeconds": 30,
    "PageSize": 1000,
    "MaxItems": 100000,
    "ServerErrorRetries": 3,
    "ServerErrorRetryDelaySeconds": 5
  },
  "MailSync": {
    "LookbackDays": 7,
    "InitialMessagesPerCategory": 10,
    "ExpandedMessagesPerCategory": 30,
    "MaxStoredEmailsPerAccount": 30,
    "SyncInboxOnly": false,
    "MaxConcurrentSyncs": 4,
    "TimeoutMinutes": 120
  },
  "AccountStorage": {
    "Enabled": false
  },
  "OutboundMail": {
    "Enabled": true,
    "MaxAttachmentCount": 10,
    "MaxTotalAttachmentBytes": 10485760
  },
  "CredentialEncryption": {
    "KeyFilePath": ".runtime/credential_encryption_key"
  },
  "LocalImport": {
    "AllowedPaths": ["/private/tmp"]
  }
}
