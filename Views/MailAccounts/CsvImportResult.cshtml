@inject Microsoft.Extensions.Localization.IStringLocalizer<MailArchiver.SharedResource> Localizer
@model MailArchiver.Models.ViewModels.CsvImportResultViewModel
@{
    ViewData["Title"] = Localizer["CsvImportResult"];
    var verificationAction = Model.Status == "AwaitingVerification" ? "VerifyCsvImport" : "RetryCsvImportVerification";
    var verificationButtonText = Model.Status == "AwaitingVerification" ? "验证本批账号" : "重试失败账号";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">@Localizer["CsvImportResult"]</h1>
        <div class="d-flex gap-2">
            <a asp-action="ImportCsv" class="btn btn-primary btn-sm">
                <i class="bi bi-upload"></i> @Localizer["CsvImportAgain"]
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> @Localizer["BackToAccounts"]
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
        </div>
    }

    <div class="alert @((Model.FailedCount > 0 && Model.CreatedCount + Model.UpdatedCount == 0) ? "alert-danger" : (Model.FailedCount > 0 ? "alert-warning" : "alert-success"))">
        <h5 class="mb-2">
            <i class="bi @(Model.CreatedCount + Model.UpdatedCount > 0 ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
            已新增 @Model.CreatedCount 个，覆盖更新 @Model.UpdatedCount 个，跳过 @Model.SkippedCount 个，失败 @Model.FailedCount 个。
        </h5>
        <div class="row text-center mt-3">
            <div class="col-md-3 mb-2">
                <div class="badge bg-success p-3 w-100">
                    <div class="h4 mb-0">@Model.CreatedCount</div>
                    <small>@Localizer["CsvImportCreated"]</small>
                </div>
            </div>
            <div class="col-md-3 mb-2">
                <div class="badge bg-primary p-3 w-100">
                    <div class="h4 mb-0">@Model.UpdatedCount</div>
                    <small>覆盖更新</small>
                </div>
            </div>
            <div class="col-md-3 mb-2">
                <div class="badge bg-warning text-dark p-3 w-100">
                    <div class="h4 mb-0">@Model.SkippedCount</div>
                    <small>@Localizer["CsvImportSkipped"]</small>
                </div>
            </div>
            <div class="col-md-3 mb-2">
                <div class="badge bg-danger p-3 w-100">
                    <div class="h4 mb-0">@Model.FailedCount</div>
                    <small>@Localizer["CsvImportFailed"]</small>
                </div>
            </div>
        </div>
    </div>

    @if (Model.PendingVerificationCount > 0 || (Model.Status == "CompletedWithErrors" && Model.VerificationFailedCount > 0))
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center gap-3">
            <div>
                @if (Model.PendingVerificationCount > 0)
                {
                    <span><strong>已保存，等待验证：</strong>@Model.PendingVerificationCount 个账号尚未连接邮箱服务器。</span>
                    @if (Model.FormatWarningCount > 0)
                    {
                        <span>其中 @Model.FormatWarningCount 个 Gmail 授权码格式待确认。</span>
                    }
                }
                else
                {
                    <span><strong>仍有账号验证失败：</strong>可只重试失败账号。</span>
                }
                @if (Model.WarningCount > 0)
                {
                    <span class="d-block small mt-1">字段警告 @Model.WarningCount 条：CSV 域名与邮箱地址冲突的行已按邮箱地址处理。</span>
                }
            </div>
            @if ((Model.Status == "AwaitingVerification" || Model.Status == "CompletedWithErrors") && !string.IsNullOrWhiteSpace(Model.JobId))
            {
                <form asp-action="@verificationAction" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="jobId" value="@Model.JobId" />
                    <button type="submit" class="btn btn-primary btn-sm">@verificationButtonText</button>
                </form>
            }
        </div>
    }

    @if (Model.WarningCount > 0 && Model.PendingVerificationCount == 0 && Model.VerificationFailedCount == 0)
    {
        <div class="alert alert-warning">字段警告 @Model.WarningCount 条：CSV 域名与邮箱地址冲突的行已按邮箱地址处理。</div>
    }

    @if (Model.VerificationSuccessCount > 0 || Model.VerificationFailedCount > 0)
    {
        <div class="alert @(Model.VerificationFailedCount > 0 ? "alert-warning" : "alert-success")">
            已验证成功 @Model.VerificationSuccessCount 个，验证失败 @Model.VerificationFailedCount 个。
            @if (Model.VerificationFailedCount > 0)
            {
                <span class="d-block small mt-1">
                    格式 @Model.VerificationFormatFailureCount · 认证 @Model.VerificationAuthFailureCount · 网络/TLS @Model.VerificationNetworkFailureCount · 服务商限流 @Model.VerificationRateLimitCount
                </span>
            }
        </div>
    }

    @if (Model.CreatedRows.Any() || Model.UpdatedRows.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>“已新增”和“覆盖更新”只代表凭证已保存，不代表邮箱已验证或可以收信。
        </div>
    }

    @if (Model.CreatedRows.Any())
    {
        <div class="card mb-3">
            <div class="card-header bg-light d-flex align-items-center justify-content-between">
                <span class="h6 mb-0"><i class="bi bi-check-circle text-success me-2"></i>@Localizer["CsvImportCreated"]</span>
                <span class="badge bg-success">@Model.CreatedCount</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>@Localizer["CsvImportEmail"]</th>
                                <th>@Localizer["CsvImportNameCol"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.CreatedRows)
                            {
                                <tr>
                                    <td>@row.Email</td>
                                    <td>@row.Name</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (Model.UpdatedRows.Any())
    {
        <div class="card mb-3">
            <div class="card-header bg-light d-flex align-items-center justify-content-between">
                <span class="h6 mb-0"><i class="bi bi-arrow-repeat text-primary me-2"></i>覆盖更新</span>
                <span class="badge bg-primary">@Model.UpdatedCount</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm mb-0">
                        <thead class="table-dark"><tr><th>@Localizer["CsvImportEmail"]</th><th>@Localizer["CsvImportNameCol"]</th></tr></thead>
                        <tbody>
                            @foreach (var row in Model.UpdatedRows)
                            {
                                <tr><td>@row.Email</td><td>@row.Name</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (Model.SkippedRows.Any())
    {
        <div class="card mb-3">
            <div class="card-header bg-light d-flex align-items-center justify-content-between">
                <span class="h6 mb-0"><i class="bi bi-skip-forward text-warning me-2"></i>@Localizer["CsvImportSkipped"]</span>
                <span class="badge bg-warning text-dark">@Model.SkippedCount</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>@Localizer["CsvImportEmail"]</th>
                                <th>@Localizer["CsvImportReason"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.SkippedRows)
                            {
                                <tr>
                                    <td>@row.Email</td>
                                    <td>@row.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (Model.FailedRows.Any())
    {
        <div class="card mb-3">
            <div class="card-header bg-light d-flex align-items-center justify-content-between">
                <span class="h6 mb-0"><i class="bi bi-x-circle text-danger me-2"></i>@Localizer["CsvImportFailed"]</span>
                <span class="badge bg-danger">@Model.FailedCount</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>文件</th>
                                <th style="width: 80px;">@Localizer["CsvImportRowNumber"]</th>
                                <th>@Localizer["CsvImportEmail"]</th>
                                <th>@Localizer["CsvImportReason"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.FailedRows)
                            {
                                <tr>
                                    <td>@(string.IsNullOrEmpty(row.FileName) ? "-" : row.FileName)</td>
                                    <td>@(row.LineNumber > 0 ? row.LineNumber.ToString() : "-")</td>
                                    <td>@(string.IsNullOrEmpty(row.Email) ? "-" : row.Email)</td>
                                    <td>@row.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
