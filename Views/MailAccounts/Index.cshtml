@using MailArchiver.Models.ViewModels
@inject MailArchiver.Services.IAuthenticationService AuthService
@inject Microsoft.Extensions.Options.IOptions<MailArchiver.Models.OutboundMailOptions> OutboundMailOptions
@model IEnumerable<MailAccountViewModel>
@{
    ViewData["Title"] = "邮箱账号";
    var isAdmin = AuthService.IsCurrentUserAdmin(Context);
    var isSelfManager = AuthService.IsCurrentUserSelfManager(Context);
    var canManage = isAdmin || isSelfManager;
    var search = ViewBag.AccountSearch as string ?? string.Empty;
    var currentPage = (int?)ViewBag.AccountPage ?? 1;
    var pageSize = (int?)ViewBag.AccountPageSize ?? 50;
    var total = (int?)ViewBag.AccountTotalCount ?? Model.Count();
    var totalPages = (int?)ViewBag.AccountTotalPages ?? 1;
    var rowNumber = (currentPage - 1) * pageSize;
    ViewBag.IsAdmin = isAdmin;
    ViewBag.CanExport = canManage;
}

<div class="account-page">
    <div class="account-sync-notice d-none" id="accountSyncNotice" role="status" aria-live="polite"></div>
    <header class="account-page__header">
        <div>
            <p class="account-page__eyebrow">KOUZI MAIL</p>
            <h1>邮箱账号</h1>
            <p class="account-page__summary">搜索账号，直接打开最近 1 个月的收件箱。</p>
        </div>
        <div class="account-page__actions">
            @if (canManage)
            {
                <a asp-action="ImportCsv" class="btn btn-light btn-sm">
                    <i class="bi bi-upload" aria-hidden="true"></i>
                    导入账号
                </a>
                <form asp-action="SyncAll" method="post" class="d-inline" onsubmit="return confirm('将同步全部已启用邮箱。未同步过的邮箱会下载最近 30 天邮件，任务可能持续较长时间。确认继续吗？');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm" title="同步全部邮箱">
                        <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                        同步全部
                    </button>
                </form>
                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal"
                        data-bs-target="#whitelistDeletionModal">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    @(isAdmin ? "全局加白删除" : "加白删除")
                </button>
            }
            @if (OutboundMailOptions.Value.Enabled)
            {
                <a asp-controller="OutboundMailTasks" asp-action="Index" class="btn btn-primary btn-sm">
                    <i class="bi bi-calendar2-check" aria-hidden="true"></i>
                    发件任务
                </a>
                <a asp-controller="OutboundMail" asp-action="Index" class="btn btn-primary btn-sm">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                    写邮件
                </a>
            }
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                添加账号
            </a>
        </div>
    </header>

    <section class="account-toolbar" aria-label="账号搜索">
        <form asp-action="Index" method="get" class="account-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" name="q" value="@search" placeholder="搜索邮箱地址或名称" aria-label="搜索邮箱地址或名称" autocomplete="off" />
            <button type="submit" class="btn btn-primary btn-sm">搜索</button>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a asp-action="Index" class="account-search__clear" aria-label="清除搜索" title="清除搜索">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </a>
            }
        </form>
        <span class="account-toolbar__count">共 @total.ToString("N0") 个账号</span>
    </section>

    <section class="account-table-wrap">
        <div class="table-responsive">
            <table class="table account-table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="account-table__index">#</th>
                        <th scope="col">邮箱地址</th>
                        <th scope="col">状态</th>
                        <th scope="col">最近同步</th>
                        <th scope="col" class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        rowNumber++;
                        <tr>
                            <td class="account-table__index text-muted">@rowNumber</td>
                            <td>
                                <div class="account-address">@item.EmailAddress</div>
                                <div class="account-name">@item.Name · @item.ProviderLabel</div>
                            </td>
                            <td>
                                @if (item.IsEnabled)
                                {
                                    <span class="status-badge status-badge--ok"><span aria-hidden="true"></span>正常</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge--off"><span aria-hidden="true"></span>已停用</span>
                                }
                                @if (item.CanReceive && item.CanSend)
                                {
                                    <div class="small text-muted mt-1">@item.ProviderLabel 可收发</div>
                                }
                                else if (item.CanReceive)
                                {
                                    <div class="small text-muted mt-1">@item.ProviderLabel 可收件@(string.IsNullOrWhiteSpace(item.RequiredAction) ? string.Empty : $"，{item.RequiredAction}")</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(item.RequiredAction))
                                {
                                    <div class="small text-muted mt-1">@item.RequiredAction</div>
                                }
                            </td>
                            <td class="account-last-sync">
                                @if (item.LastSync > new DateTime(1970, 1, 1))
                                {
                                    <span class="utc-timestamp" data-utc-time="@item.LastSync.Value.ToString("yyyy-MM-ddTHH:mm:ss")">@item.LastSync.Value.ToString("yyyy-MM-dd HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted">尚未同步</span>
                                }
                                <div class="account-sync-result d-none" data-sync-result="@item.Id" aria-live="polite"></div>
                            </td>
                            <td>
                                <div class="account-row-actions">
                                    <a asp-controller="Emails" asp-action="Index" asp-route-SelectedAccountId="@item.Id"
                                       class="btn btn-primary btn-sm account-view-btn">
                                        <i class="bi bi-inbox" aria-hidden="true"></i>
                                        查看
                                    </a>
                                    @if (item.Provider != ProviderType.IMPORT)
                                    {
                                        <form asp-action="Sync" asp-route-id="@item.Id" method="post"
                                              class="account-sync-form"
                                              data-account-id="@item.Id"
                                              data-status-url="@Url.Action("SyncStatus", "MailAccounts", new { id = item.Id })">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary btn-sm account-icon-btn account-sync-button" title="刷新收件箱" aria-label="刷新收件箱">
                                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (OutboundMailOptions.Value.Enabled && item.CanSend)
                                    {
                                        <a asp-controller="OutboundMail" asp-action="Index" asp-route-accountId="@item.Id"
                                           class="btn btn-outline-primary btn-sm account-icon-btn" title="用此账号写邮件" aria-label="用此账号写邮件">
                                            <i class="bi bi-send" aria-hidden="true"></i>
                                        </a>
                                    }
                                    else if (OutboundMailOptions.Value.Enabled && item.MailProviderKind == MailProviderKind.Outlook)
                                    {
                                        <a asp-action="AuthorizeMsaDevice" asp-route-id="@item.Id"
                                           class="btn btn-outline-warning btn-sm account-icon-btn" title="授权 Outlook 收发" aria-label="授权 Outlook 收发">
                                            <i class="bi bi-shield-lock" aria-hidden="true"></i>
                                        </a>
                                    }
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm account-icon-btn" title="编辑账号" aria-label="编辑账号">
                                        <i class="bi bi-three-dots" aria-hidden="true"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm account-icon-btn"
                                            title="删除账号"
                                            aria-label="删除账号"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteAccountModal"
                                            data-account-id="@item.Id"
                                            data-account-email="@item.EmailAddress"
                                            data-email-count="@item.ArchivedEmailCount">
                                        <i class="bi bi-trash3" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="account-empty">
                <i class="bi bi-inbox" aria-hidden="true"></i>
                @if (string.IsNullOrWhiteSpace(search))
                {
                    <strong>还没有邮箱账号</strong>
                    <span>添加账号后，就可以从这里直接查看收件箱。</span>
                }
                else
                {
                    <strong>没有匹配的账号</strong>
                    <span>换一个邮箱地址或名称试试。</span>
                }
            </div>
        }
    </section>

    @if (totalPages > 1)
    {
        <nav class="account-pagination" aria-label="账号分页">
            @if (currentPage > 1)
            {
                <a asp-action="Index" asp-route-q="@search" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize" class="btn btn-light btn-sm">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    上一页
                </a>
            }
            <span>第 @currentPage / @totalPages 页</span>
            @if (currentPage < totalPages)
            {
                <a asp-action="Index" asp-route-q="@search" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize" class="btn btn-light btn-sm">
                    下一页
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
            }
        </nav>
    }
</div>

<div class="modal fade account-delete-modal" id="deleteAccountModal" tabindex="-1"
     aria-labelledby="deleteAccountModalLabel" aria-describedby="deleteAccountMessage" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Delete" method="post" class="modal-content" id="deleteAccountForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteAccountId" />
            <div class="modal-header">
                <h2 class="modal-title fs-6" id="deleteAccountModalLabel">删除邮箱</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="取消"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" id="deleteAccountMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
                <button type="submit" class="btn btn-danger" id="confirmSingleDelete">确认删除</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade whitelist-delete-modal" id="whitelistDeletionModal" tabindex="-1"
     aria-labelledby="whitelistDeletionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form asp-action="WhitelistDelete" method="post" class="modal-content" id="whitelistDeletionForm"
              data-preview-url="@Url.Action("WhitelistDeletionPreview", "MailAccounts")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PreviewFingerprint" id="whitelistPreviewFingerprint" />
            <div class="modal-header">
                <h2 class="modal-title fs-6" id="whitelistDeletionModalLabel">@(isAdmin ? "全局加白删除" : "加白删除")</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="取消"></button>
            </div>
            <div class="modal-body">
                <label for="whitelistSourceText" class="form-label fw-semibold">粘贴需要保留的邮箱文本</label>
                <textarea class="form-control whitelist-source" id="whitelistSourceText" name="SourceText"
                          rows="8" required spellcheck="false"
                          placeholder="name@example.com"></textarea>
                <div class="form-text">仅识别以 .com 结尾的完整邮箱地址；识别到的账号保留，@(isAdmin ? "数据库中的其余全部账号" : "分配给你的其余账号")删除，不受当前页和搜索条件影响。</div>

                <div class="alert alert-danger mt-3 mb-0 d-none" id="whitelistPreviewError" role="alert"></div>

                <section class="whitelist-preview mt-3 d-none" id="whitelistPreview" aria-live="polite">
                    <p class="whitelist-preview__summary mb-2" id="whitelistPreviewSummary"></p>
                    <dl class="whitelist-preview__lists mb-0">
                        <div>
                            <dt>保留账号</dt>
                            <dd id="whitelistKeepEmails"></dd>
                        </div>
                        <div>
                            <dt>待删除账号</dt>
                            <dd id="whitelistDeleteEmails"></dd>
                        </div>
                    </dl>
                    <p class="whitelist-preview__note mb-0 d-none" id="whitelistUnmatchedNote"></p>
                </section>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-outline-secondary" id="previewWhitelistDeletion">
                    识别并预览
                </button>
                <button type="submit" class="btn btn-danger" id="confirmWhitelistDeletion" disabled>
                    确认删除
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const syncNotice = document.getElementById('accountSyncNotice');

            function showSyncMessage(resultElement, message, tone) {
                resultElement.textContent = message;
                resultElement.className = `account-sync-result account-sync-result--${tone}`;
                syncNotice.textContent = message;
                syncNotice.className = `account-sync-notice account-sync-notice--${tone}`;
            }

            async function waitForSync(form, requestedAt) {
                const accountId = form.dataset.accountId;
                const resultElement = document.querySelector(`[data-sync-result="${accountId}"]`);
                const button = form.querySelector('.account-sync-button');
                const statusUrl = new URL(form.dataset.statusUrl, window.location.origin);
                if (requestedAt) {
                    statusUrl.searchParams.set('startedAfter', requestedAt);
                }
                const deadline = Date.now() + 2 * 60 * 60 * 1000;

                while (Date.now() < deadline) {
                    await new Promise(resolve => window.setTimeout(resolve, 1200));
                    const response = await fetch(statusUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!response.ok) throw new Error('无法读取同步状态，请稍后重试。');
                    const status = await response.json();
                    const job = status.job;

                    if (job?.status === 'Completed') {
                        const message = job.newEmails > 0
                            ? `同步完成，新增 ${job.newEmails.toLocaleString()} 封邮件。`
                            : '同步完成，未检测到新邮件。';
                        showSyncMessage(resultElement, message, 'success');
                        return;
                    }
                    if (job?.status === 'Failed' || job?.status === 'Cancelled' || job?.status === 'RateLimited') {
                        const prefix = job.status === 'RateLimited' ? '同步已暂停' : '同步失败';
                        showSyncMessage(resultElement, `${prefix}：${job.errorMessage || '请检查邮箱授权后重试。'}`, 'error');
                        return;
                    }

                    const runningMessage = status.state === 'Queued'
                        ? '等待同步，当前邮箱已加入队列。'
                        : '正在同步邮件…';
                    showSyncMessage(resultElement, runningMessage, 'progress');
                }

                throw new Error('同步仍在后台进行，可稍后回来查看邮件。');
            }

            document.querySelectorAll('.account-sync-form').forEach(form => {
                form.addEventListener('submit', async event => {
                    event.preventDefault();
                    const button = form.querySelector('.account-sync-button');
                    const resultElement = document.querySelector(`[data-sync-result="${form.dataset.accountId}"]`);
                    button.disabled = true;
                    button.classList.add('is-syncing');
                    showSyncMessage(resultElement, '正在启动同步…', 'progress');

                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        const payload = await response.json();
                        if (!response.ok) throw new Error(payload.message || '无法启动同步。');
                        await waitForSync(form, payload.requestedAt);
                    } catch (error) {
                        showSyncMessage(resultElement, error.message || '同步失败，请稍后重试。', 'error');
                    } finally {
                        button.disabled = false;
                        button.classList.remove('is-syncing');
                    }
                });
            });

            const deleteModal = document.getElementById('deleteAccountModal');
            const deleteForm = document.getElementById('deleteAccountForm');
            const deleteAccountId = document.getElementById('deleteAccountId');
            const deleteMessage = document.getElementById('deleteAccountMessage');
            const singleDeleteButton = document.getElementById('confirmSingleDelete');

            deleteModal.addEventListener('show.bs.modal', function (event) {
                const trigger = event.relatedTarget;
                const accountId = trigger.getAttribute('data-account-id');
                const accountEmail = trigger.getAttribute('data-account-email');
                const emailCount = Number(trigger.getAttribute('data-email-count') || 0);

                deleteAccountId.value = accountId;
                deleteMessage.textContent =
                    `是否删除邮箱 ${accountEmail}？删除后该邮箱账号及 ${emailCount.toLocaleString()} 条邮件将被永久删除。`;
                singleDeleteButton.disabled = false;
                singleDeleteButton.textContent = '确认删除';
            });

            deleteForm.addEventListener('submit', function () {
                singleDeleteButton.disabled = true;
                singleDeleteButton.textContent = '正在删除...';
            });

            const whitelistModal = document.getElementById('whitelistDeletionModal');
            const whitelistForm = document.getElementById('whitelistDeletionForm');
            const sourceText = document.getElementById('whitelistSourceText');
            const previewButton = document.getElementById('previewWhitelistDeletion');
            const confirmButton = document.getElementById('confirmWhitelistDeletion');
            const fingerprint = document.getElementById('whitelistPreviewFingerprint');
            const preview = document.getElementById('whitelistPreview');
            const previewError = document.getElementById('whitelistPreviewError');
            const previewSummary = document.getElementById('whitelistPreviewSummary');
            const keepEmails = document.getElementById('whitelistKeepEmails');
            const deleteEmails = document.getElementById('whitelistDeleteEmails');
            const unmatchedNote = document.getElementById('whitelistUnmatchedNote');

            function invalidateWhitelistPreview() {
                fingerprint.value = '';
                confirmButton.disabled = true;
                confirmButton.textContent = '确认删除';
                preview.classList.add('d-none');
                previewError.classList.add('d-none');
            }

            function summarizeEmails(emails, count) {
                if (count === 0) return '无';
                const visible = emails.join('、');
                return count > emails.length ? `${visible} 等 ${count.toLocaleString()} 个` : visible;
            }

            whitelistModal.addEventListener('show.bs.modal', function () {
                whitelistForm.reset();
                invalidateWhitelistPreview();
                previewButton.disabled = false;
                previewButton.textContent = '识别并预览';
            });

            sourceText.addEventListener('input', invalidateWhitelistPreview);

            previewButton.addEventListener('click', async function () {
                if (!sourceText.reportValidity()) return;

                previewButton.disabled = true;
                previewButton.textContent = '识别中...';
                previewError.classList.add('d-none');

                try {
                    const response = await fetch(whitelistForm.dataset.previewUrl, {
                        method: 'POST',
                        body: new FormData(whitelistForm),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const result = await response.json();
                    if (!response.ok) {
                        throw new Error(result.message || '识别失败，请检查粘贴内容。');
                    }

                    fingerprint.value = result.previewFingerprint;
                    previewSummary.textContent =
                        `将保留 ${result.keepCount.toLocaleString()} 个账号，删除 ${result.deleteAccountCount.toLocaleString()} 个账号及 ${result.deleteEmailCount.toLocaleString()} 条邮件。`;
                    keepEmails.textContent = summarizeEmails(result.keepEmails, result.keepCount);
                    deleteEmails.textContent = summarizeEmails(result.deleteEmails, result.deleteAccountCount);

                    if (result.unmatchedCount > 0) {
                        unmatchedNote.textContent =
                            `另有 ${result.unmatchedCount.toLocaleString()} 个识别出的邮箱不在可管理账号中。`;
                        unmatchedNote.classList.remove('d-none');
                    } else {
                        unmatchedNote.classList.add('d-none');
                    }

                    preview.classList.remove('d-none');
                    confirmButton.disabled = result.deleteAccountCount === 0;
                    confirmButton.textContent = result.deleteAccountCount === 0
                        ? '无需删除'
                        : `确认删除 ${result.deleteAccountCount.toLocaleString()} 个账号`;
                } catch (error) {
                    fingerprint.value = '';
                    preview.classList.add('d-none');
                    previewError.textContent = error.message;
                    previewError.classList.remove('d-none');
                    confirmButton.disabled = true;
                } finally {
                    previewButton.disabled = false;
                    previewButton.textContent = '重新识别';
                }
            });

            whitelistForm.addEventListener('submit', function (event) {
                if (!fingerprint.value) {
                    event.preventDefault();
                    return;
                }

                confirmButton.disabled = true;
                previewButton.disabled = true;
                confirmButton.textContent = '正在提交...';
            });
        });
    </script>
}
