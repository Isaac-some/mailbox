@inject Microsoft.Extensions.Localization.IStringLocalizer<MailArchiver.SharedResource> Localizer
@model MailArchiver.Models.ViewModels.BulkImportImapViewModel
@{
    ViewData["Title"] = Localizer["CsvImportTitle"];
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">@Localizer["CsvImportTitle"]</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> @Localizer["BackToAccounts"]
        </a>
    </div>

    <div class="msa-info-banner mb-3">
        <div class="d-flex align-items-start">
            <i class="bi bi-info-circle-fill me-2 mt-1"></i>
            <div>
                <strong>识别并保存邮箱与授权码，不在导入时连接邮箱服务器。</strong>
                <ul class="mb-2 mt-1">
                    <li>不要求固定列数；程序会从常见中英文表头或行内容中识别邮箱和授权码，可直接导入截图这类带“邮箱、密码、IMAP授权码、2fa”的文件。</li>
                    <li>自动清理授权码中的空格、换行和不可见字符；保留大小写和符号。</li>
                    <li>标准格式固定为 <code>email, domain, credential, client_id</code>；Outlook OAuth2 才填写 <code>client_id</code>，其他邮箱留空。</li>
                    <li>能识别到有效邮箱和非空授权码即导入成功；不在此处判断授权码能否登录。</li>
                    <li>打开邮箱或点击刷新时才连接邮箱服务器，并分别提示“授权码无效”或“连接失败”。</li>
                    <li>同邮箱再次导入时，用新四字段完整覆盖旧数据。</li>
                    <li>@Localizer["CsvImportAdminOnlyNote"]</li>
                </ul>
                <a asp-action="DownloadExampleCsv" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-download me-1"></i> @Localizer["DownloadExampleCsv"]
                </a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light">
            <span class="h6 mb-0"><i class="bi bi-file-earmark-spreadsheet me-1"></i>@Localizer["CsvImportSettingsTitle"]</span>
        </div>
        <div class="card-body">
            <form asp-action="ImportCsv" method="post" enctype="multipart/form-data" id="csvImportForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="form-section">
                    <div class="form-section-header">
                        <i class="bi bi-file-earmark-arrow-up me-1"></i> 账号文件
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccountFiles" class="form-label">选择 CSV 文件</label>
                        <input asp-for="AccountFiles" type="file" class="form-control"
                               accept=".csv,text/csv" id="accountFileInput" multiple required>
                        <div class="form-text">可一次选择最多 20 个 CSV 文件；每个文件最多 10 MB。</div>
                        <span asp-validation-for="AccountFiles" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-section-header">
                        <i class="bi bi-database me-1"></i> 自动识别与保存
                    </div>

                    <div class="alert alert-light border mb-3">
                        <strong>自动识别：</strong>邮箱列支持“邮箱、邮箱地址、email”等写法；授权列支持“IMAP授权码、授权码、应用专用密码、密码”等写法。
                        同时有“密码”和“IMAP授权码”时优先使用 IMAP 授权码。16 位授权码可带分组空格，导入时会自动清理。
                        导入只检查文件结构并保存，不连接邮箱服务器；打开邮箱或点击刷新时才验证授权码。
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsEnabled" class="form-check-input" type="checkbox" role="switch">
                            <label asp-for="IsEnabled" class="form-check-label">@Localizer["AccountEnabledLabel"]</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="saveBtn">
                        <i class="bi bi-upload"></i> 导入
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["BackToList"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const i18n = {
            saving: '正在检查文件，请稍候…',
            submit: '导入'
        };
        document.addEventListener('DOMContentLoaded', function() {
            const csvForm = document.getElementById('csvImportForm');
            const saveBtn = document.getElementById('saveBtn');

            csvForm.addEventListener('submit', function() {
                if (typeof $ !== 'undefined' && !$(this).valid()) {
                    return;
                }
                if (saveBtn) {
                    saveBtn.disabled = true;
                    saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> ' + i18n.saving;
                }
            });
        });
    </script>
}
