@using MailArchiver.Models
@inject MailArchiver.Services.IAuthenticationService AuthService
@inject Microsoft.Extensions.Localization.IStringLocalizer<MailArchiver.SharedResource> Localizer
@model MailArchiver.Models.ViewModels.SearchViewModel
@{
    var account = ViewBag.SelectedAccount;
    var selectedEmail = Model.SearchResults?.FirstOrDefault(email => email.Id == Model.SelectedEmailId);
    var totalPages = Math.Max(1, Model.TotalPages);
    var syncState = ViewBag.SyncState as string;
    var categories = Enum.GetValues<MailboxFolderCategory>()
        .OrderBy(category => category == MailboxFolderCategory.Other ? 99 : (int)category)
        .ToList();
    var currentCategoryName = Model.SelectedFolderCategory?.ToDisplayName() ?? "全部邮件";
    var initialCategoryLimit = 10;
    var mailboxReturnUrl = Url.Action("Index", "Emails", new
    {
        Model.SelectedAccountId,
        Model.SelectedFolderCategory,
        Model.SearchTerm,
        Model.PageNumber,
        Model.PageSize
    });
    ViewData["Title"] = account?.Name ?? "全部邮件";
}

<div class="mailbox-page" data-mailbox-sync-account="@account?.Id">
    <header class="mailbox-header">
        <div class="mailbox-header__identity">
            <a asp-controller="MailAccounts" asp-action="Index" class="icon-button" aria-label="返回邮箱账号" title="返回邮箱账号">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
            </a>
            <div>
                <p class="mailbox-header__eyebrow">@currentCategoryName</p>
                <h1>@account?.Name</h1>
                <p>@account?.EmailAddress</p>
            </div>
        </div>
        <div class="mailbox-header__actions">
            <form id="mailbox-refresh-form" class="mailbox-sync-form" data-mailbox-sync-form asp-controller="MailAccounts" asp-action="Sync" asp-route-id="@account?.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="mailbox-window" aria-label="同步时间范围">
                    <label class="@(Model.MailboxSyncLookbackDays == 7 ? "selected" : "")">
                        <input type="radio" name="lookbackDays" value="7" checked="@(Model.MailboxSyncLookbackDays == 7 ? "checked" : null)" />7天
                    </label>
                    <label class="@(Model.MailboxSyncLookbackDays == 30 ? "selected" : "")" title="30 天同步时间可能更长">
                        <input type="radio" name="lookbackDays" value="30" checked="@(Model.MailboxSyncLookbackDays == 30 ? "checked" : null)" />30天
                    </label>
                </div>
                <span class="mailbox-window__note" data-mailbox-window-note hidden="@(Model.MailboxSyncLookbackDays != 30 ? "hidden" : null)">30 天同步较慢</span>
                <button type="submit" class="btn btn-primary btn-sm" data-mailbox-refresh-button>
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                    刷新邮件
                </button>
            </form>
            <a asp-controller="MailAccounts" asp-action="Edit" asp-route-id="@account?.Id" class="icon-button" aria-label="编辑账号" title="编辑账号">
                <i class="bi bi-three-dots" aria-hidden="true"></i>
            </a>
        </div>
    </header>

    <div class="mailbox-sync-status" id="mailbox-sync-status" aria-live="polite" hidden>
        <span class="mailbox-sync-scan" aria-hidden="true"></span>
        <span id="mailbox-sync-message">正在扫描新邮件，当前页面可继续查看。</span>
    </div>
    <div id="mailbox-sync-error" class="alert alert-danger" role="alert" hidden></div>
    <form id="mailbox-watch-sync-token" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <section class="mailbox-toolbar">
        <form asp-action="Index" method="get" class="mailbox-search">
            <input type="hidden" name="SelectedAccountId" value="@Model.SelectedAccountId" />
            <input type="hidden" name="SelectedFolderCategory" value="@Model.SelectedFolderCategory" />
            <input type="hidden" name="PageNumber" value="1" />
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" name="SearchTerm" value="@Model.SearchTerm" placeholder="搜索主题或发件人" aria-label="搜索主题或发件人" autocomplete="off" />
            <button type="submit" class="btn btn-light btn-sm">搜索</button>
        </form>
        <span class="mailbox-toolbar__meta">
            @Model.TotalResults.ToString("N0") 封邮件 · 最近 @ViewBag.LookbackDays 天
        </span>
    </section>

    <nav class="mailbox-folder-filter" aria-label="邮件文件夹分类">
        <a asp-action="Index"
           asp-route-SelectedAccountId="@Model.SelectedAccountId"
           asp-route-SearchTerm="@Model.SearchTerm"
           class="@(Model.SelectedFolderCategory == null ? "selected" : "")">
            全部 <span>@Model.FolderCategoryCounts.Values.Sum()</span>
        </a>
        @foreach (var category in categories)
        {
            var count = Model.FolderCategoryCounts.GetValueOrDefault(category);
            <a asp-action="Index"
               asp-route-SelectedAccountId="@Model.SelectedAccountId"
               asp-route-SelectedFolderCategory="@category"
               asp-route-SearchTerm="@Model.SearchTerm"
               class="@(Model.SelectedFolderCategory == category ? "selected" : "")">
                @category.ToDisplayName() <span>@count</span>
            </a>
        }
    </nav>

    <section class="mailbox-split">
        <div class="mailbox-list" aria-label="邮件列表">
            @if (Model.SearchResults != null && Model.SearchResults.Any())
            {
                @foreach (var email in Model.SearchResults)
                {
                    var isSelected = email.Id == Model.SelectedEmailId;
                    <a asp-action="Index"
                       asp-route-SelectedAccountId="@Model.SelectedAccountId"
                       asp-route-SelectedEmailId="@email.Id"
                       asp-route-SelectedFolderCategory="@Model.SelectedFolderCategory"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-PageNumber="@Model.PageNumber"
                       asp-route-PageSize="@Model.PageSize"
                       data-mobile-details-url="@Url.Action("Details", "Emails", new { id = email.Id, returnUrl = mailboxReturnUrl })"
                       class="mail-item @(isSelected ? "mail-item--selected" : "")">
                        <div class="mail-item__topline">
                            <strong>@(string.IsNullOrWhiteSpace(email.From) ? "未知发件人" : email.From)</strong>
                            <time data-time-format="short" data-utc-time="@email.ReceivedDate.ToString("yyyy-MM-ddTHH:mm:ss")">@email.ReceivedDate.ToString("MM-dd HH:mm")</time>
                        </div>
                        <div class="mail-item__subject">@(string.IsNullOrWhiteSpace(email.Subject) ? "(无主题)" : email.Subject)</div>
                        <div class="mail-item__folder">
                            <span class="mail-folder-badge mail-folder-badge--@email.FolderCategory.ToString().ToLowerInvariant()">@email.FolderCategory.ToDisplayName()</span>
                            @if (!string.IsNullOrWhiteSpace(email.FolderName))
                            {
                                <span>@email.FolderName</span>
                            }
                        </div>
                        <div class="mail-item__preview">@((email.Body ?? string.Empty).Replace("\r", " ").Replace("\n", " ").Trim())</div>
                    </a>
                }
            }
            else
            {
                <div class="mailbox-empty">
                    <i class="bi bi-inbox" aria-hidden="true"></i>
                    <strong>@currentCategoryName 暂无邮件</strong>
                    <span>点击右上角刷新邮件。</span>
                </div>
            }
        </div>

        <article class="mail-viewer">
            @if (selectedEmail != null)
            {
                <header class="mail-viewer__header">
                    <h2>@(string.IsNullOrWhiteSpace(selectedEmail.Subject) ? "(无主题)" : selectedEmail.Subject)</h2>
                    <p>
                        <strong>@selectedEmail.From</strong>
                        <span>收件于 <time data-utc-time="@selectedEmail.ReceivedDate.ToString("yyyy-MM-ddTHH:mm:ss")">@selectedEmail.ReceivedDate.ToString("yyyy-MM-dd HH:mm")</time></span>
                    </p>
                    <a asp-controller="Emails" asp-action="Details" asp-route-id="@selectedEmail.Id"
                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                       class="mail-viewer__details">
                        打开完整邮件 <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                    </a>
                </header>
                <div class="mail-viewer__body">
                    <iframe src="@Url.Action("RawContent", new { id = selectedEmail.Id })"
                            title="邮件正文" class="mail-viewer__content-frame"
                            sandbox="allow-popups allow-popups-to-escape-sandbox allow-downloads"></iframe>
                </div>
            }
            else
            {
                <div class="mail-viewer__empty">
                    <i class="bi bi-envelope-open" aria-hidden="true"></i>
                    <span>请选择一封邮件</span>
                </div>
            }
        </article>
    </section>

    @if (Model.SelectedFolderCategory.HasValue && !Model.IsSelectedCategoryExpanded
        && Model.FolderCategoryCounts.GetValueOrDefault(Model.SelectedFolderCategory.Value) >= initialCategoryLimit)
    {
        <form class="mailbox-load-more mailbox-sync-form" data-mailbox-sync-form asp-controller="MailAccounts" asp-action="Sync" asp-route-id="@account?.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="lookbackDays" value="@Model.MailboxSyncLookbackDays" />
            <input type="hidden" name="folderCategory" value="@Model.SelectedFolderCategory" />
            <input type="hidden" name="loadMore" value="true" />
            <button type="submit" class="btn btn-light btn-sm">
                <i class="bi bi-chevron-down" aria-hidden="true"></i> 查看更多，最多 30 封
            </button>
        </form>
    }

    @if (totalPages > 1)
    {
        <nav class="mailbox-pagination" aria-label="邮件分页">
            @if (Model.PageNumber > 1)
            {
                <a asp-action="Index" asp-route-SelectedAccountId="@Model.SelectedAccountId" asp-route-SelectedFolderCategory="@Model.SelectedFolderCategory" asp-route-SearchTerm="@Model.SearchTerm" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-PageSize="@Model.PageSize" class="btn btn-light btn-sm">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i> 上一页
                </a>
            }
            <span>第 @Model.PageNumber / @totalPages 页</span>
            @if (Model.PageNumber < totalPages)
            {
                <a asp-action="Index" asp-route-SelectedAccountId="@Model.SelectedAccountId" asp-route-SelectedFolderCategory="@Model.SelectedFolderCategory" asp-route-SearchTerm="@Model.SearchTerm" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-PageSize="@Model.PageSize" class="btn btn-light btn-sm">
                    下一页 <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
            }
        </nav>
    }
</div>

@section Scripts {
<script>
    (() => {
        const page = document.querySelector('[data-mailbox-sync-account]');
        const token = document.querySelector('#mailbox-watch-sync-token input[name="__RequestVerificationToken"]');
        const status = document.getElementById('mailbox-sync-status');
        const statusMessage = document.getElementById('mailbox-sync-message');
        const syncError = document.getElementById('mailbox-sync-error');
        const refreshForm = document.getElementById('mailbox-refresh-form');
        const syncForms = document.querySelectorAll('[data-mailbox-sync-form]');

        const compactWindow = window.matchMedia('(max-width: 768px)');
        document.querySelectorAll('[data-mobile-details-url]').forEach(item => {
            item.addEventListener('click', event => {
                if (!compactWindow.matches || event.button !== 0
                    || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

                event.preventDefault();
                window.location.assign(item.dataset.mobileDetailsUrl);
            });
        });

        if (!page || !page.dataset.mailboxSyncAccount || !token || !status) return;

        const accountId = page.dataset.mailboxSyncAccount;
        const openSync = new URLSearchParams(window.location.search).get('autoSync') === 'true';
        if (openSync) {
            const cleanUrl = new URL(window.location.href);
            cleanUrl.searchParams.delete('autoSync');
            window.history.replaceState({}, document.title, cleanUrl.toString());
        }
        let sawActiveSync = '@syncState' === 'Queued' || '@syncState' === 'Running';
        let startedAfter = null;

        const showSyncError = (message) => {
            if (!syncError) return;
            syncError.textContent = message;
            syncError.hidden = false;
        };

        const friendlySyncError = (message) => {
            const text = typeof message === 'string' ? message.trim() : '';
            return text && /[\u3400-\u9fff]/.test(text)
                ? text
                : '连接失败，请检查网络、VPN、代理或邮箱服务是否可访问。';
        };

        const setStatus = (active, message = '正在扫描新邮件，当前页面可继续查看。') => {
            status.hidden = !active;
            if (active && statusMessage) statusMessage.textContent = message;
        };

        const submitSync = async (event) => {
            event.preventDefault();
            const form = event.currentTarget;
            const submitButton = form.querySelector('button[type="submit"]');
            if (submitButton?.disabled) return;

            submitButton.disabled = true;
            if (syncError) syncError.hidden = true;
            setStatus(true);
            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: new URLSearchParams(new FormData(form)),
                    credentials: 'same-origin'
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok) throw new Error(result.message || '暂时无法启动同步，请稍后再试。');
                startedAfter = result.requestedAt || null;
                sawActiveSync = true;
            } catch (error) {
                sawActiveSync = false;
                setStatus(false);
                showSyncError(error.message || '暂时无法启动同步，请稍后再试。');
            } finally {
                submitButton.disabled = false;
            }
        };
        syncForms.forEach(form => form.addEventListener('submit', submitSync));

        document.querySelectorAll('.mailbox-window input').forEach(input => {
            input.addEventListener('change', () => {
                document.querySelectorAll('.mailbox-window label').forEach(label =>
                    label.classList.toggle('selected', label.querySelector('input')?.checked));
                const note = document.querySelector('[data-mailbox-window-note]');
                if (note) note.hidden = input.value !== '30' || !input.checked;
            });
        });

        // The account list marks a deliberate mailbox open with autoSync=true.
        // Remove that one-shot marker before the queue completes so its reload
        // cannot start a second sync. Direct links and search/pagination remain
        // read-only until the user presses Refresh.
        if (openSync && !sawActiveSync && refreshForm) {
            refreshForm.requestSubmit();
        }

        const watch = async () => {
            try {
                const body = new URLSearchParams({
                    id: accountId,
                    __RequestVerificationToken: token.value
                });
                if (startedAfter) body.set('startedAfter', startedAfter);
                const response = await fetch('@Url.Action("WatchSync", "MailAccounts")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body,
                    credentials: 'same-origin'
                });
                if (!response.ok) return;

                const payload = await response.json();
                const active = payload.state === 'Queued' || payload.state === 'Running';
                setStatus(active);
                if (!active && sawActiveSync && payload.job) {
                    sawActiveSync = false;
                    if (payload.job.status === 'Failed') {
                        showSyncError(friendlySyncError(payload.job.errorMessage));
                    } else if (payload.job.status === 'Cancelled' || payload.job.status === 'RateLimited') {
                        showSyncError(payload.job.errorMessage || '同步已取消、超时或受到服务商限流，请稍后重试。');
                    } else {
                        window.location.reload();
                    }
                    return;
                }
                sawActiveSync = sawActiveSync || active;
            } catch (_) {
                // A transient local network failure must not interrupt mailbox reading.
            }
        };

        setStatus(sawActiveSync);
        window.setInterval(watch, 5000);
    })();
</script>
}
