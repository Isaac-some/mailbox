@using MailArchiver.Models
@model MailArchiver.ViewModels.OutboundMailTaskIndexViewModel
@{
    ViewData["Title"] = "发件任务";
}

<div class="account-page">
    <header class="account-page__header">
        <div>
            <p class="account-page__eyebrow">邮箱助手</p>
            <h1>发件任务</h1>
            <p class="account-page__summary">上传 CSV，可选择点击即发，也可按表格中的时间定时发送。</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="DownloadTemplate" class="btn btn-light btn-sm">
                <i class="bi bi-download" aria-hidden="true"></i> 下载模板
            </a>
            <a asp-controller="MailAccounts" asp-action="Index" class="btn btn-light btn-sm">返回邮箱账号</a>
        </div>
    </header>

    <nav class="outbound-steps" aria-label="发件流程" role="tablist">
        <button type="button" role="tab" data-step="prepare" aria-selected="true">1 · 生成发件 CSV</button>
        <button type="button" role="tab" data-step="send" aria-selected="false">2 · 上传并发件</button>
        <button type="button" role="tab" data-step="history" aria-selected="false">3 · 发件历史</button>
    </nav>
    <section class="card sender-csv-builder mb-4" id="step-prepare" role="tabpanel" data-task-panel="prepare">
        <div class="card-header d-flex align-items-center justify-content-between gap-3 flex-wrap">
            <div>
                <h2 class="h5 mb-1">生成发件 CSV</h2>
                <p class="small text-muted mb-0">从账号库选择，或导入一份名单自动匹配。</p>
            </div>
            <div class="sender-builder__count" aria-live="polite">
                已选 <strong id="selectedSenderCount">0</strong> / <span id="availableSenderCount">@Model.SenderAccountCount</span>
            </div>
        </div>
        <div class="sender-builder__layout">
            <section class="sender-builder__accounts" aria-labelledby="senderAccountHeading">
                <div class="sender-builder__toolbar">
                    <div>
                        <h3 class="h6 mb-1" id="senderAccountHeading">当前邮箱账号</h3>
                        <p class="small text-muted mb-0">选中后排队更新授权；可继续准备 CSV。</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="clearSenderSelection">清空</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="selectVisibleSenders">全选筛选结果</button>
                    </div>
                </div>
                <label for="senderAccountSearch" class="visually-hidden">搜索当前邮箱账号</label>
                <div class="sender-builder__search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" id="senderAccountSearch" placeholder="搜索邮箱或名称" autocomplete="off" />
                </div>
                <div data-sender-picker id="taskSenders" data-input-name="SelectedAccountIds" data-max="5000" data-external-search="senderAccountSearch">
                    <div class="sender-chips" data-selected></div>
                    <div class="sender-account-list" id="senderAccountList" data-results aria-live="polite"></div>
                    <p class="small" data-preparation aria-live="polite"></p>
                </div>
            </section>

            <section class="sender-builder__matcher" aria-labelledby="senderMatchHeading">
                <div>
                    <h3 class="h6 mb-1" id="senderMatchHeading">从外部名单匹配</h3>
                    <p class="small text-muted mb-0">整块粘贴表格，或上传名单文件；只提取邮箱地址。</p>
                </div>
                <form asp-action="PreviewSenderSelection" method="post" enctype="multipart/form-data" id="senderMatchForm"
                      data-preview-url="@Url.Action("PreviewSenderSelection", "OutboundMailTasks")">
                    @Html.AntiForgeryToken()
                    <label for="senderSourceText" class="form-label mt-3">粘贴名单</label>
                    <textarea class="form-control" id="senderSourceText" name="SourceText" rows="7"
                              spellcheck="false" placeholder="可直接粘贴一列、多列或整张表格"></textarea>
                    <label for="senderListFile" class="form-label mt-3">或上传文件</label>
                    <input class="form-control" id="senderListFile" name="ListFile" type="file"
                           accept=".xlsx,.csv,.tsv,.txt,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,text/tab-separated-values,text/plain" />
                    <div class="form-text">支持 XLSX、CSV、TSV、TXT，最多 5 MB。</div>
                    <button type="submit" class="btn btn-outline-primary w-100 mt-3" id="matchSenderButton">
                        <i class="bi bi-check2-square" aria-hidden="true"></i> 匹配并选中
                    </button>
                </form>
                <div class="alert alert-danger mt-3 mb-0 d-none" id="senderMatchError" role="alert"></div>
                <div class="sender-match-result d-none" id="senderMatchResult" aria-live="polite">
                    <p class="mb-2" id="senderMatchSummary"></p>
                    <dl class="mb-0">
                        <div class="d-none" id="unavailableSenderResult"><dt>不可发件</dt><dd id="unavailableSenderEmails"></dd></div>
                        <div class="d-none" id="unmatchedSenderResult"><dt>库内未找到</dt><dd id="unmatchedSenderEmails"></dd></div>
                    </dl>
                </div>
            </section>
        </div>
        <form asp-action="DownloadSenderCsv" method="post" id="senderDownloadForm" class="sender-builder__footer">
            @Html.AntiForgeryToken()
            <div id="selectedSenderInputs"></div>
            <p class="small text-muted mb-0">下载后填写收件邮箱、主题和正文；选择定时控制时再填写时间。</p>
            <button type="submit" class="btn btn-primary" id="downloadSenderCsv" disabled>
                <i class="bi bi-download" aria-hidden="true"></i> 下载已选邮箱 CSV
            </button>
        </form>
    </section>

    <button type="button" class="btn btn-link" data-step="send">已有 CSV，跳过这一步 →</button>
    <section class="card mb-4" id="step-send" role="tabpanel" data-task-panel="send" hidden>
        <div class="card-body p-4">
            <h2 class="h5 mb-3">新建任务</h2>
            <form asp-action="Import" method="post" enctype="multipart/form-data" id="taskImportForm">
                @Html.AntiForgeryToken()
                <fieldset class="mb-3">
                    <legend class="form-label mb-2">发送方式</legend>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="border rounded-3 p-3 d-flex gap-2 h-100" for="timingModeImmediate">
                                <input asp-for="TimingMode" class="form-check-input mt-1" type="radio"
                                       id="timingModeImmediate" value="@OutboundMailTaskTimingMode.SendImmediately" />
                                <span><strong class="d-block">点击即发（推荐）</strong><span class="small text-muted">创建任务后立即排队，不检查 CSV 的时间列。</span></span>
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="border rounded-3 p-3 d-flex gap-2 h-100" for="timingModeScheduled">
                                <input asp-for="TimingMode" class="form-check-input mt-1" type="radio"
                                       id="timingModeScheduled" value="@OutboundMailTaskTimingMode.UseCsvSchedule" />
                                <span><strong class="d-block">定时控制</strong><span class="small text-muted">CSV 必须有时间列，且每一行都要填写有效时间。</span></span>
                            </label>
                        </div>
                    </div>
                </fieldset>
                <div class="row g-3 align-items-end">
                    <div class="col-lg-8">
                        <label asp-for="CsvFile" class="form-label">发件 CSV</label>
                        <input asp-for="CsvFile" type="file" accept=".csv,text/csv" class="form-control" required />
                        <div class="form-text">
                            始终必需：发件邮箱、收件邮箱、主题、正文。定时控制还必须有时间列，时间按 @Model.TimeZoneId 解释。最多 5,000 行、5 MB。
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <button type="submit" class="btn btn-primary w-100" id="createTaskButton">
                            <i class="bi bi-calendar2-check" aria-hidden="true"></i> 创建发件任务
                        </button>
                    </div>
                </div>
            </form>

            @if (Model.ImportErrors.Count > 0)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    <strong>CSV 未创建任务，请先修正以下问题：</strong>
                    <ul class="mb-0 mt-2">
                        @foreach (var error in Model.ImportErrors.Take(100))
                        {
                            <li>第 @error.LineNumber 行：@error.Reason</li>
                        }
                    </ul>
                    @if (Model.ImportErrors.Count > 100)
                    {
                        <p class="mb-0 mt-2">另有 @(Model.ImportErrors.Count - 100) 个问题未显示。</p>
                    }
                </div>
            }
        </div>
    </section>

    <section class="card shadow-sm border-0" id="step-history" role="tabpanel" data-task-panel="history" hidden>
        <div class="card-body p-0">
            <div class="p-4 pb-2"><h2 class="h5 mb-0">最近任务</h2></div>
            @if (Model.Tasks.Count == 0)
            {
                <div class="p-4 text-muted">还没有发件任务。</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>任务</th><th>创建时间</th><th>进度</th><th>异常</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var task in Model.Tasks)
                            {
                                <tr>
                                    <td><strong>@task.Name</strong><div class="small text-muted">共 @task.Total 封</div></td>
                                    <td><span data-utc-time="@task.CreatedAtUtc.ToString("yyyy-MM-ddTHH:mm:ss")">@task.CreatedAtUtc</span></td>
                                    <td>
                                        <span class="badge text-bg-success">已发 @task.Sent</span>
                                        @if (task.Pending > 0) { <span class="badge text-bg-secondary">待发 @task.Pending</span> }
                                        @if (task.Sending > 0) { <span class="badge text-bg-primary">发送中 @task.Sending</span> }
                                    </td>
                                    <td>
                                        @if (task.Failed > 0) { <span class="badge text-bg-danger">失败 @task.Failed</span> }
                                        @if (task.Interrupted > 0) { <span class="badge text-bg-warning">结果不确定 @task.Interrupted</span> }
                                        @if (task.Cancelled > 0) { <span class="badge text-bg-light">已取消 @task.Cancelled</span> }
                                    </td>
                                    <td class="text-end"><a asp-action="Details" asp-route-id="@task.Id" class="btn btn-outline-primary btn-sm">查看</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/sender-picker.js" asp-append-version="true"></script>
    <script>
        const tabs = document.querySelectorAll('.outbound-steps [data-step]');
        function showStep(step) {
            if (!['prepare','send','history'].includes(step)) step = 'prepare';
            document.querySelectorAll('[data-task-panel]').forEach(panel => panel.hidden = panel.dataset.taskPanel !== step);
            tabs.forEach(tab => tab.setAttribute('aria-selected', String(tab.dataset.step === step)));
            history.replaceState(null, '', '#' + step);
        }
        document.querySelectorAll('[data-step]').forEach(button => button.addEventListener('click', () => showStep(button.dataset.step)));
        tabs.forEach((tab, i) => tab.addEventListener('keydown', event => {
            if (!['ArrowLeft','ArrowRight'].includes(event.key)) return;
            event.preventDefault();
            const target = tabs[(i + (event.key === 'ArrowRight' ? 1 : 2)) % 3];
            target.focus(); showStep(target.dataset.step);
        }));
        showStep(@(Model.ImportErrors.Count > 0 ? "true" : "false") ? 'send' : location.hash.slice(1));
        const picker = document.getElementById('taskSenders');
        picker.addEventListener('selectionchange', event => {
            const selected = event.detail;
            document.getElementById('selectedSenderCount').textContent = selected.length.toLocaleString();
            document.getElementById('downloadSenderCsv').disabled = selected.length === 0;
            document.getElementById('selectedSenderInputs').replaceChildren(...selected.map(account => {
                const input = document.createElement('input'); input.type = 'hidden';
                input.name = 'SelectedAccountIds'; input.value = account.id; return input;
            }));
        });
        document.getElementById('clearSenderSelection').addEventListener('click', () => picker.senderPicker.clear());
        document.getElementById('selectVisibleSenders').addEventListener('click', () => picker.senderPicker.selectVisible());
        document.getElementById('senderMatchForm').addEventListener('submit', async function(event) {
            event.preventDefault(); const button = document.getElementById('matchSenderButton');
            const error = document.getElementById('senderMatchError');
            button.disabled = true; button.textContent = '正在匹配…'; error.classList.add('d-none');
            try {
                const response = await fetch(this.dataset.previewUrl, { method: 'POST', body: new FormData(this) });
                const result = await response.json(); if (!response.ok) throw new Error(result.message || '匹配失败，请重试。');
                picker.senderPicker.replace(result.matchedAccounts);
                document.getElementById('senderMatchResult').classList.remove('d-none');
                document.getElementById('senderMatchSummary').textContent = `识别 ${result.recognizedCount} 个，已选中 ${result.matchedCount} 个；已停用 ${result.unavailableCount} 个，库内未找到 ${result.unmatchedCount} 个。`;
            } catch(e) { error.textContent = e.message; error.classList.remove('d-none'); }
            finally { button.disabled = false; button.textContent = '匹配并选中'; }
        });
        document.getElementById('taskImportForm').addEventListener('submit', function() {
            if (!this.checkValidity()) return;
            const button = document.getElementById('createTaskButton'); button.disabled = true;
            button.textContent = '正在校验 CSV…';
        });
    </script>
}
