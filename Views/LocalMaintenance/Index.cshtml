@model MailArchiver.ViewModels.LocalMaintenanceViewModel
@using MailArchiver.Models
@{
    ViewData["Title"] = "本机数据";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="d-flex align-items-center mb-4">
            <i class="bi bi-pc-display-horizontal fs-3 text-primary me-3"></i>
            <div>
                <h1 class="h3 mb-1">本机数据</h1>
                <p class="text-muted mb-0">管理这台设备的邮箱助手。</p>
            </div>
        </div>

        <section class="border-top pt-4 mb-5">
            <h2 class="h5">应用更新</h2>
            <p class="text-muted">在应用内下载并安装新版，保留账号、邮件和设置。</p>
            <a asp-controller="DesktopUpdates" asp-action="Index" class="btn btn-outline-primary">检查更新</a>
        </section>

        <section class="border-top pt-4 mb-5">
            <h2 class="h5">邮箱账号来源</h2>
            <p class="text-muted">仅使用手动导入的 CSV，已关闭线上账号拉取。同一邮箱再次导入会覆盖凭据，保留已归档邮件。</p>
            <a asp-controller="MailAccounts" asp-action="ImportCsv" class="btn btn-outline-primary">导入 CSV</a>
        </section>

        <section class="border-top pt-4 mb-5">
            <h2 class="h5">网络连接</h2>
            <p class="text-muted">跟随这台电脑当前的系统网络与 VPN。应用不保存或使用单独的代理配置。</p>
            <p class="mt-3 mb-0"><a asp-action="Diagnostics"><i class="bi bi-activity me-1" aria-hidden="true"></i>打开网络诊断</a></p>
        </section>

        <section class="border-top pt-4 mb-5">
            <h2 class="h5">本地账号</h2>
            <p class="text-muted mb-0">本机版打开即可使用，无需登录。</p>
        </section>

        <section class="border-top pt-4 mb-5">
            <h2 class="h5">清空邮件和附件</h2>
            <p class="text-muted">删除已下载的邮件、附件和同步记录，保留已导入的邮箱账号。</p>
            <form asp-action="ClearMailData" method="post" data-busy-label="正在清空邮件和附件…" onsubmit="return confirm('确定清空这台设备上的所有邮件和附件吗？邮箱账号会保留。');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>清空邮件和附件
                </button>
            </form>
        </section>

        <section class="border-top pt-4">
            <h2 class="h5 text-danger">清空本机所有数据</h2>
            <p class="text-muted">删除这台设备上的账号、邮件、附件、登录状态和本机密钥；应用随后会重新启动。</p>
            <form asp-action="FactoryReset" method="post" data-busy-label="正在重置本机数据…" onsubmit="return confirm('确定清空这台设备上的所有邮箱数据吗？此操作不可撤销。');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>清空本机所有数据
                </button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/mailbox-initialization.js" asp-append-version="true"></script>
}
