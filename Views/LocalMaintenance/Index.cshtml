@model MailArchiver.ViewModels.LocalMaintenanceViewModel
@{
    ViewData["Title"] = "本机数据";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="d-flex align-items-center mb-4">
            <i class="bi bi-pc-display-horizontal fs-3 text-primary me-3"></i>
            <div>
                <h1 class="h3 mb-1">本机数据</h1>
                <p class="text-muted mb-0">管理这台设备的邮箱助手。</p>
            </div>
        </div>

        <section class="border-top pt-4 mb-5">
            <h2 class="h5">本地账号</h2>
            <p class="text-muted mb-0">本机版使用两个固定账号登录。账号启停状态由 GitHub 清单控制；修改清单后，下一次登录会立即生效。</p>
        </section>

        <section class="border-top pt-4 mb-5">
            <h2 class="h5">清空邮件和附件</h2>
            <p class="text-muted">删除已下载的邮件、附件和同步记录，保留已导入的邮箱账号。</p>
            <form asp-action="ClearMailData" method="post" onsubmit="return confirm('确定清空这台 Mac 上的所有邮件和附件吗？邮箱账号会保留。');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>清空邮件和附件
                </button>
            </form>
        </section>

        <section class="border-top pt-4">
            <h2 class="h5 text-danger">清空本机所有数据</h2>
            <p class="text-muted">删除这台 Mac 上的账号、邮件、附件、登录状态和本机密钥；应用随后会重新启动。</p>
            <form asp-action="FactoryReset" method="post" onsubmit="return confirm('确定清空这台 Mac 上的所有邮箱数据吗？此操作不可撤销。');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>清空本机所有数据
                </button>
            </form>
        </section>
    </div>
</div>
