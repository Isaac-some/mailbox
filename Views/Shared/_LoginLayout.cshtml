<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 邮箱助手</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css">
    <link rel="icon" type="image/png" href="~/icons/icon-192x192.png">
    <style>
        body {
            margin: 0;
            background: #f5f5f7;
            color: #1d1d1f;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
        }
        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 0 20px;
        }
        .login-card {
            border: 1px solid rgba(60, 60, 67, .18);
            border-radius: 12px;
            box-shadow: 0 16px 40px rgba(28, 28, 30, .12);
            background: rgba(255, 255, 255, .88);
            backdrop-filter: blur(20px) saturate(180%);
        }
        .card-body {
            padding: 2rem 2rem 1.75rem;
        }
        .card-footer {
            background: transparent;
            border-top: 1px solid rgba(60, 60, 67, .16);
            border-radius: 0 0 12px 12px;
        }
        .form-control, .input-group-text {
            border-radius: 8px;
        }
        .input-group .form-control {
            border-left: none;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }
        .input-group-text {
            background: rgba(118, 118, 128, .08);
            border-right: none;
        }
        .btn-lg {
            border-radius: 8px;
            padding: 11px;
        }
        .alert {
            border-radius: 8px;
        }
        .login-brand-mark {
            width: 58px;
            height: 58px;
            border-radius: 15px;
            box-shadow: 0 3px 8px rgba(0, 0, 0, .18);
        }
        .login-card h2 {
            font-size: 1.35rem;
            font-weight: 650;
            letter-spacing: 0;
        }
        .login-card .text-muted {
            color: #6e6e73 !important;
        }
        .login-card .btn-primary {
            border-color: #007aff;
            background: #007aff;
        }
        .login-card .btn-primary:hover {
            border-color: #0066d6;
            background: #0066d6;
        }
        .login-card .form-control:focus {
            border-color: #007aff;
            box-shadow: 0 0 0 3px rgba(0, 122, 255, .18);
        }
        @@media (prefers-reduced-transparency: reduce) {
            .login-card { background: #fff; backdrop-filter: none; }
        }
        @@media (max-width: 480px) {
            .login-container {
                padding: 0 10px;
            }
            .card-body {
                padding: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <main class="login-main">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
