@inject Microsoft.Extensions.Localization.IStringLocalizer<MailArchiver.SharedResource> Localizer
@inject Microsoft.Extensions.Options.IOptions<MailArchiver.Models.TimeZoneOptions> TimeZoneOptions
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var csvImportJobId = TempData["CsvImportJobId"] as string;
    var csvStatusUrl = Url.Action("CsvImportStatusJson", "MailAccounts");
    var csvResultUrl = Url.Action("CsvImportStatus", "MailAccounts");
    var csvVerifyUrl = Url.Action("VerifyCsvImport", "MailAccounts");
    var csvRetryUrl = Url.Action("RetryCsvImportVerification", "MailAccounts");
}
<!DOCTYPE html>
<html lang="@currentCulture">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        // The desktop app uses the light theme only.
        document.documentElement.removeAttribute('data-theme');
        try { localStorage.setItem('theme', 'light'); } catch (_) { }
    </script>
    <title>@ViewData["Title"] - 邮箱助手</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mailbox.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile-tables.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/icons/icon-192x192.png">
    <link rel="manifest" href="~/manifest.json">
    <!-- Apple touch icons for iOS home screen -->
    <link rel="apple-touch-icon" href="~/icons/icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/icons/icon-192x192.png">
    <link rel="apple-touch-icon" sizes="152x152" href="~/icons/icon-152x152.png">
    <link rel="apple-touch-icon" sizes="120x120" href="~/icons/icon-128x128.png">
    <meta name="apple-mobile-web-app-title" content="邮箱助手">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
</head>

<body>
    <header class="app-chrome">
        <nav class="navbar navbar-expand-lg fixed-top" aria-label="应用工具栏">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="MailAccounts" asp-action="Index">
                    <img src="~/icons/icon-128x128.png" alt="" class="app-brand-mark" />
                    <span>邮箱助手</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto"></ul>
                    <div class="app-toolbar-actions d-flex align-items-center">
                        @if (string.Equals(Environment.GetEnvironmentVariable("MAIL_ASSISTANT_LOCAL_APP"), "1", StringComparison.Ordinal))
                        {
                            <a class="btn btn-toolbar-icon btn-sm me-2" asp-controller="LocalMaintenance" asp-action="Index" title="本机数据" aria-label="本机数据">
                                <i class="bi bi-gear" aria-hidden="true"></i>
                            </a>
                        }
                        @await Html.PartialAsync("_UserInfo")
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid body-content">
        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <aside id="csvImportTasks" class="csv-import-tasks d-none" aria-live="polite" aria-label="导入任务">
        <div class="csv-import-tasks__header">
            <strong><i class="bi bi-cloud-arrow-up me-1" aria-hidden="true"></i>导入任务</strong>
            <button type="button" class="btn btn-sm btn-link" id="csvImportTasksToggle" aria-expanded="true" aria-label="折叠导入任务">
                <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </button>
        </div>
        <div id="csvImportTasksList" class="csv-import-tasks__list"></div>
    </aside>
    @Html.AntiForgeryToken()

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (() => {
            const introducedJobId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(csvImportJobId));
            const statusUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(csvStatusUrl));
            const resultUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(csvResultUrl));
            const verifyUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(csvVerifyUrl));
            const retryUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(csvRetryUrl));
            const storageKey = 'mailAssistant.csvImportJobs';
            const collapsedKey = 'mailAssistant.csvImportTasksCollapsed';
            const panel = document.getElementById('csvImportTasks');
            const list = document.getElementById('csvImportTasksList');
            const toggle = document.getElementById('csvImportTasksToggle');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const labels = {
                Queued: '排队中', Running: '正在保存', AwaitingVerification: '等待验证',
                Verifying: '正在验证', Completed: '已完成',
                CompletedWithErrors: '已完成，部分失败', Failed: '任务失败'
            };

            let jobs;
            let lastRecords = [];
            try { jobs = JSON.parse(sessionStorage.getItem(storageKey) || '[]'); } catch (_) { jobs = []; }
            if (!Array.isArray(jobs)) jobs = [];
            if (introducedJobId && !jobs.includes(introducedJobId)) jobs.unshift(introducedJobId);
            jobs = jobs.slice(0, 5);
            sessionStorage.setItem(storageKey, JSON.stringify(jobs));

            const render = (records, refreshError) => {
                panel.classList.toggle('d-none', !jobs.length);
                if (!jobs.length) return;
                if (records.length) lastRecords = records;
                const visibleRecords = records.length ? records : lastRecords;
                const collapsed = sessionStorage.getItem(collapsedKey) === 'true';
                panel.classList.toggle('csv-import-tasks--collapsed', collapsed);
                toggle.setAttribute('aria-expanded', String(!collapsed));
                list.innerHTML = visibleRecords.map(job => {
                    const total = job.verificationStarted && job.verificationTotal ? job.verificationTotal : job.total;
                    const processed = job.verificationStarted
                        && (job.status === 'Verifying' || job.status === 'Completed' || job.status === 'CompletedWithErrors')
                        ? job.verificationProcessed : job.processed;
                    const phase = job.verificationStarted ? '验证' : '保存';
                    const percent = total ? Math.min(100, Math.round(processed * 100 / total)) : 0;
                    const verify = job.status === 'AwaitingVerification'
                        ? `<button class="btn btn-primary btn-sm csv-import-verify" data-job-id="${job.jobId}" data-action-url="${verifyUrl}">验证本批账号</button>`
                        : job.status === 'CompletedWithErrors' && job.verificationFailed > 0
                            ? `<button class="btn btn-outline-primary btn-sm csv-import-verify" data-job-id="${job.jobId}" data-action-url="${retryUrl}">重试失败账号</button>` : '';
                    return `<section class="csv-import-task">
                        <div class="d-flex justify-content-between gap-2"><span>${labels[job.status] || job.status}</span><span>${processed}/${total}</span></div>
                        <div class="progress mt-1" role="progressbar" aria-label="${phase}进度" aria-valuenow="${percent}" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:${percent}%"></div></div>
                        <div class="csv-import-task__counts">保存 ${job.created + job.updated} · 待验证 ${job.pendingVerification} · 格式待确认 ${job.formatWarnings} · 字段警告 ${job.warnings} · 失败 ${job.failed + job.verificationFailed}</div>
                        ${job.verificationFailed ? `<div class="csv-import-task__counts">格式 ${job.verificationFormatFailures} · 认证 ${job.verificationAuthFailures} · 网络/TLS ${job.verificationNetworkFailures} · 限流 ${job.verificationRateLimits}</div>` : ''}
                        <div class="csv-import-task__actions">${verify}<a href="${resultUrl}?jobId=${encodeURIComponent(job.jobId)}" class="btn btn-outline-secondary btn-sm">查看结果</a></div>
                    </section>`;
                }).join('') + (refreshError ? '<div class="csv-import-tasks__error">暂时无法刷新进度。</div>' : '');
                list.querySelectorAll('.csv-import-verify').forEach(button => button.addEventListener('click', async () => {
                    button.disabled = true;
                    try {
                        await fetch(button.dataset.actionUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
                            body: `jobId=${encodeURIComponent(button.dataset.jobId)}&__RequestVerificationToken=${encodeURIComponent(token || '')}`
                        });
                    } finally { refresh(); }
                }));
            };

            const refresh = async () => {
                if (!jobs.length) return;
                try {
                    const records = await Promise.all(jobs.map(async jobId => {
                        const response = await fetch(`${statusUrl}?jobId=${encodeURIComponent(jobId)}`, { cache: 'no-store' });
                        if (!response.ok) throw new Error('status unavailable');
                        return response.json();
                    }));
                    render(records, false);
                    if (records.every(job => ['Completed', 'CompletedWithErrors', 'Failed'].includes(job.status))) return;
                } catch (_) { render([], true); }
                window.setTimeout(refresh, 1500);
            };
            toggle.addEventListener('click', () => {
                const collapsed = sessionStorage.getItem(collapsedKey) === 'true';
                sessionStorage.setItem(collapsedKey, String(!collapsed));
                panel.classList.toggle('csv-import-tasks--collapsed', !collapsed);
                toggle.setAttribute('aria-expanded', String(collapsed));
            });
            refresh();
        })();
    </script>
    <script>
        // Product policy: every user sees the same Beijing timestamps,
        // independent of the browser or operating-system timezone.
        const displayTimeZone = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TimeZoneOptions.Value.DisplayTimeZoneId));
        localStorage.setItem('timezone', displayTimeZone);

        // Funktion zum Konvertieren von UTC-Zeiten zu lokaler Zeit
        function convertUTCToLocal(utcDateString, shortFormat = false) {
            if (!utcDateString) return utcDateString;

            try {
                // Preserve an explicit source offset; only timezone-less
                // archive values need the UTC marker appended.
                const hasOffset = /(?:Z|[+-]\d{2}:?\d{2})$/i.test(utcDateString);
                const utcDate = new Date(hasOffset ? utcDateString : utcDateString + 'Z');

                if (isNaN(utcDate.getTime())) {
                    console.warn('Invalid date format:', utcDateString);
                    return utcDateString; // Return original if parsing fails
                }

                // Get the culture from the HTML lang attribute
                const cultureLang = document.documentElement.lang || 'de-DE';
                
                // Format in local timezone with culture-specific formatting
                return utcDate.toLocaleString(cultureLang, {
                    year: shortFormat ? undefined : 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit',
                    timeZone: displayTimeZone
                });
            } catch (e) {
                console.error('Fehler bei der Datums-Konvertierung:', e, 'Ursprünglicher Wert:', utcDateString);
                return utcDateString;
            }
        }

        // Funktion zum Aktualisieren aller Zeitstempel auf der Seite
        function updateAllTimestamps() {
            // Sucht nach allen Elementen mit data-utc-time Attribut oder utc-timestamp Klasse
            const timeElements = document.querySelectorAll('[data-utc-time], .utc-timestamp[data-utc-time]');
            
            timeElements.forEach(element => {
                const utcTime = element.getAttribute('data-utc-time');
                if (utcTime && utcTime !== '0001-01-01T00:00:00' && utcTime !== '') {
                    const localTime = convertUTCToLocal(utcTime, element.dataset.timeFormat === 'short');
                    element.textContent = localTime;
                    
                    // Add a data attribute to indicate conversion has been done
                    element.setAttribute('data-converted', 'true');
                }
            });
        }

        // Führe die Konvertierung aus, wenn das Dokument geladen ist
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', updateAllTimestamps);
        } else {
            updateAllTimestamps();
        }

        // Unterstützung für dynamisch hinzugefügte Inhalte (z.B. bei AJAX-Aufrufen)
        const observer = new MutationObserver(function (mutations) {
            let shouldUpdate = false;
            mutations.forEach(function (mutation) {
                if (mutation.type === 'childList') {
                    mutation.addedNodes.forEach(function (node) {
                        if (node.nodeType === 1 &&
                            (node.hasAttribute('data-utc-time') ||
                                node.querySelectorAll && node.querySelectorAll('[data-utc-time]').length > 0)) {
                            shouldUpdate = true;
                        }
                    });
                }
            });
            if (shouldUpdate) {
                setTimeout(updateAllTimestamps, 100); // Kleine Verzögerung für bessere Performance
            }
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
